# Copy to .env and adjust as needed.

# PostgreSQL connection used by the Next.js app, the migrator and the release worker.
DATABASE_URL=postgres://smart_office:smart_office@localhost:5432/smart_office

# Office-local time zone used to interpret booking dates and periods (see plan section 2).
OFFICE_TIME_ZONE=Europe/Belgrade

# Signs the simulated sign-in session cookie (see /api/auth/login). The code
# falls back to a development-only value when unset; set a real value for demos.
SESSION_SECRET=

# Keep false until the facilitator accepts the half-day amendment in writing
# (see docs/decisions/0001-half-day-booking-policy.md). Set true only after
# that decision; otherwise the API offers full-day bookings only.
HALF_DAY_BOOKING_ENABLED=false

# Demonstration-only: shortens the no-show release deadline so the worker's effect is visible live.
# Leave unset for the normal policy deadlines in the plan's booking table.
DEMO_RELEASE_DEADLINE_MINUTES=

# Identity adapter: "synthetic" (default, POC) or "entra" (requires a ready, approved test tenant).
IDENTITY_ADAPTER=synthetic

# Set to "true" once an approved AI service is confirmed available for the conversational assistant.
# Otherwise the app falls back to the labelled guided-chat prototype (see plan section 3).
CONVERSATIONAL_ASSISTANT_LIVE=false
